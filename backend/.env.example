# ==========================================
# PTIT Contest Backend — Environment Variables
# ==========================================
# Copy thành .env và điền giá trị thực tế.
# KHÔNG commit .env vào git.

# --- Database ---
DATABASE_URL=postgresql+asyncpg://ptit_contest:dev_password@localhost:5432/ptit_contest_db

# --- App ---
APP_NAME=PTIT Contest API
APP_ENV=development         # development | staging | production
DEBUG=true
API_PREFIX=/api

# --- CORS (Flutter Web origin) ---
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost

# --- Auth ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=change-me-to-random-32-byte-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440      # 24h cho dev, prod nên giảm xuống 60

# --- Server ---
HOST=0.0.0.0
PORT=8000
