%% =========================================================
%% Sequence Diagram — Workflow Phê duyệt Đề xuất Cuộc thi (BCN_QĐ1)
%% Phiên bản: v01 (2026-05-04)
%% Schema reference: ptit_contest v03
%%
%% Cover 3 nhánh:
%%   Happy path:        DRAFT → PROPOSED → APPROVED → PUBLISHED
%%   Revision loop:     PROPOSED → REVISION_REQUESTED → PROPOSED → APPROVED
%%   Reject hoàn toàn:  PROPOSED → REJECTED → DRAFT (BTC sửa lại từ đầu)
%% =========================================================

sequenceDiagram
    autonumber
    actor BTC as BTC (Giảng viên/<br/>Ban tổ chức)
    actor BCN as BCN (Ban Chủ nhiệm khoa)
    participant FE as Flutter Web<br/>(features/organizer + features/hod)
    participant API as FastAPI Backend<br/>(routers/contests + routers/approvals)
    participant DB as PostgreSQL<br/>(ptit_contest)
    participant NTF as Notification Service

    Note over BTC,NTF: ===== A. BTC tạo và soạn thảo cuộc thi =====

    BTC->>FE: Click "Tạo cuộc thi mới"
    FE->>API: POST /api/contests<br/>{title, slug, delivery_mode, start_at, ...}
    API->>DB: INSERT INTO contests<br/>(status='DRAFT', created_by=BTC, proposed_by=BTC, host_faculty_id)
    DB-->>API: contest_id = 42
    API-->>FE: 201 Created {contest_id: 42}
    FE-->>BTC: Hiển thị form chi tiết

    loop Soạn rounds + sessions (lặp nhiều lần)
        BTC->>FE: Thêm round / session
        FE->>API: POST /api/contests/42/rounds<br/>POST /api/contests/42/sessions
        API->>DB: INSERT INTO contest_rounds / contest_sessions
    end

    Note over BTC,NTF: ===== B. BTC submit để BCN duyệt (revision_round = 1) =====

    BTC->>FE: Click "Gửi BCN duyệt"
    FE->>API: POST /api/contests/42/submit-for-approval

    rect rgb(235, 245, 255)
        Note over API,DB: Transaction: cập nhật status + tạo approval record
        API->>DB: UPDATE contests SET status='PROPOSED' WHERE contest_id=42
        API->>DB: INSERT INTO workflow_approvals<br/>(target_type='CONTEST_PROPOSAL',<br/> step='BCN_QD1', status='PENDING',<br/> revision_round=1, submitted_by=BTC,<br/> snapshot_json={title, rounds, ...})
        DB-->>API: approval_id = 7
    end

    API->>NTF: Push notify BCN khoa (host_faculty_id)
    NTF->>DB: INSERT notifications + notification_recipients<br/>(target = các department_heads của khoa)
    API-->>FE: 200 OK {approval_id: 7, status: PENDING}
    FE-->>BTC: Hiển thị "Đã gửi, chờ BCN duyệt"

    Note over BTC,NTF: ===== C. BCN xem queue + chi tiết =====

    BCN->>FE: Mở "Đề xuất chờ duyệt"
    FE->>API: GET /api/me/pending-approvals?type=CONTEST_PROPOSAL
    API->>DB: SELECT * FROM workflow_approvals wa<br/>JOIN contests c ON c.contest_id=wa.contest_id<br/>WHERE wa.target_type='CONTEST_PROPOSAL'<br/>AND wa.status='PENDING'<br/>AND c.host_faculty_id = (BCN's faculty)
    DB-->>API: [approval_id=7, ...]
    API-->>FE: Danh sách
    FE-->>BCN: List view

    BCN->>FE: Click vào approval #7
    FE->>API: GET /api/approvals/7
    API->>DB: SELECT wa.*, c.* FROM workflow_approvals wa<br/>JOIN contests c USING(contest_id) WHERE approval_id=7
    DB-->>API: Full data + snapshot_json
    API-->>FE: Detail
    FE-->>BCN: Hiển thị form xem xét<br/>(3 nút: Approve / Request Revision / Reject)

    Note over BTC,NTF: ===== D. NHÁNH 1 — Happy path: BCN APPROVE =====

    BCN->>FE: Click "Approve" + comment
    FE->>API: POST /api/approvals/7/decide<br/>{action: "approve", comment: "OK"}

    rect rgb(230, 245, 230)
        Note over API,DB: Transaction
        API->>DB: UPDATE workflow_approvals<br/>SET status='APPROVED', reviewed_by=BCN,<br/> reviewed_at=NOW(), bcn_comment='OK'<br/>WHERE approval_id=7
        API->>DB: UPDATE contests<br/>SET status='PUBLISHED' WHERE contest_id=42
    end

    API->>NTF: Notify BTC (proposed_by)
    NTF->>DB: INSERT notifications<br/>(scope='CONTEST', message='Đã duyệt')
    API-->>FE: 200 OK {status: APPROVED}
    FE-->>BCN: "Đã duyệt thành công"

    Note right of BTC: BTC sau đó có thể publish<br/>(REG_OPEN khi đến time)

    Note over BTC,NTF: ===== E. NHÁNH 2 — Revision Loop =====

    alt BCN yêu cầu chỉnh sửa
        BCN->>FE: Click "Request Revision" + comment
        FE->>API: POST /api/approvals/7/decide<br/>{action: "request_revision",<br/> comment: "Bổ sung kinh phí"}

        rect rgb(255, 248, 220)
            API->>DB: UPDATE workflow_approvals<br/>SET status='REVISION_REQUESTED', reviewed_by=BCN,<br/> bcn_comment='Bổ sung kinh phí'
            API->>DB: UPDATE contests<br/>SET status='REVISION_REQUESTED' WHERE contest_id=42
        end

        API->>NTF: Notify BTC
        API-->>FE: 200 OK
        FE-->>BCN: "Đã gửi yêu cầu chỉnh sửa"

        Note over BTC,API: BTC nhận notify, mở contest sửa

        BTC->>FE: Sửa nội dung contest
        FE->>API: PATCH /api/contests/42 {description, rules_text, ...}
        API->>DB: UPDATE contests SET ...

        BTC->>FE: Click "Gửi lại BCN"
        FE->>API: POST /api/contests/42/submit-for-approval

        rect rgb(235, 245, 255)
            Note over API,DB: revision_round = 2 (record MỚI, không update record cũ)
            API->>DB: UPDATE contests SET status='PROPOSED'
            API->>DB: INSERT INTO workflow_approvals<br/>(target_type='CONTEST_PROPOSAL', step='BCN_QD1',<br/> status='PENDING', revision_round=2,<br/> snapshot_json={...})
            DB-->>API: approval_id = 8
        end

        API->>NTF: Notify BCN
        Note right of BCN: Quay lại bước C → D<br/>Loop đến khi APPROVED
    end

    Note over BTC,NTF: ===== F. NHÁNH 3 — Reject hoàn toàn =====

    alt BCN từ chối hoàn toàn (đề xuất sai phạm vi/không phù hợp)
        BCN->>FE: Click "Reject" + lý do
        FE->>API: POST /api/approvals/7/decide<br/>{action: "reject", comment: "Trùng cuộc thi đã có"}

        rect rgb(255, 230, 230)
            API->>DB: UPDATE workflow_approvals<br/>SET status='REJECTED', reviewed_by=BCN
            API->>DB: UPDATE contests<br/>SET status='DRAFT' WHERE contest_id=42
            Note over API,DB: Status quay về DRAFT để BTC<br/>quyết định: sửa hẳn + submit lại,<br/>hoặc DELETE contest
        end

        API->>NTF: Notify BTC kèm lý do reject
        API-->>FE: 200 OK {status: REJECTED}
        FE-->>BCN: "Đã từ chối"
    end
