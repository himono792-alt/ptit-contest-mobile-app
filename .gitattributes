# Tự normalize line endings — hết bug 82 file CRLF↔LF noise
# trên cross-platform (Windows VS Code save CRLF, WSL/Linux save LF).
# Đặt 2026-05-07 sau session debug "Dashboard chưa ổn".

# Default: text file → checkout với LF (Linux/macOS norm)
* text=auto eol=lf

# Windows-only scripts giữ CRLF (PowerShell/cmd cần CRLF để chạy)
*.ps1   text eol=crlf
*.cmd   text eol=crlf
*.bat   text eol=crlf

# Source code — explicit text + LF
*.py        text eol=lf
*.dart      text eol=lf
*.kt        text eol=lf
*.java      text eol=lf
*.swift     text eol=lf
*.c         text eol=lf
